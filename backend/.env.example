# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=
MONGODB_DB_NAME=Resume_Builder

# Authentication
JWT_SECRET=
OTP_HASH_SECRET=
OTP_EXPIRES_MINUTES=10

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Gemini primary provider
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# Groq fallback provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Provider routing and integration checks
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_INTEGRATION_TEST=false


# emails (RESEND)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=